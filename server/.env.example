# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=atlantic_stars

# JWT
JWT_SECRET=your_jwt_secret_change_this
JWT_EXPIRES_IN=7d

# Tencent COS
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=atlantic-stars-products-1234567890
COS_REGION=ap-guangzhou
COS_CDN_DOMAIN=https://cdn.example.com
COS_APP_ID=your_app_id

# AI
# Set to false on servers that can directly reach OpenAI/Gemini.
AI_USE_PROXY=false
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CLAUDE_BASE_URL=https://api.anthropic.com/v1

# Optional: keep these only if AI_USE_PROXY=true.
AI_PROXY_BASE_URL=
AI_PROXY_TOKEN=
